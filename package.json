{
  "name": "@han/claude-browser-mcp",
  "version": "1.0.0",
  "description": "面向 AI 编程助手的浏览器自动化与接口测试 MCP 服务器，基于 Playwright + CDP",
  "main": "./dist/index.js",
  "type": "module",
  "bin": {
    "claude-browser-mcp": "./dist/index.js",
    "browser-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --format=esm --outfile=dist/index.js --external:@modelcontextprotocol/sdk --external:playwright --external:zod",
    "build:minify": "esbuild src/index.js --bundle --platform=node --format=esm --minify --outfile=dist/index.js --external:@modelcontextprotocol/sdk --external:playwright --external:zod",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "dev": "node src/index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "browser",
    "playwright",
    "automation",
    "cdp",
    "e2e",
    "api-testing"
  ],
  "author": "zhaolibin001",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/zhaolibin001/smart-browser.git"
  },
  "homepage": "https://gitee.com/zhaolibin001/smart-browser",
  "bugs": {
    "url": "https://gitee.com/zhaolibin001/smart-browser/issues"
  },
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright": "^1.61.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
